// Application schema: the current coprocessor.fbs, restated as services.

include "rpc.fbs";

namespace CoprocessorProto;

table WifiConnectRequest {
    ssid: string;
    password: string;
}

table WifiStatus {
    connected: bool;
    ip: string;
    ssid: string;
    rssi: int16;
}

table StartProvisioning {
    timeout_seconds: uint32;
}

enum ProvisioningState : ubyte { Inactive, Active, Provisioned, TimedOut }

table ProvisioningStatus {
    state: ProvisioningState;
}

table TimeSync {
    epoch_seconds: uint64;
    subsec_micros: uint32;
}

table BatteryStatus {
    millivolts: uint32;
    percent: uint8;
    is_plugged: bool;
}

/// Network control, implemented by the co-processor.
rpc_service Wifi (server: "coprocessor") {
    Connect(WifiConnectRequest): Rpc.Empty (id: "1", timeout_ms: "1000");
    StartProvisioning(StartProvisioning): Rpc.Empty (id: "2");
    StopProvisioning(Rpc.Empty): Rpc.Empty (id: "3");
}

/// Network state pushed to the S3.
rpc_service WifiEvents (server: "s3") {
    Status(WifiStatus): Rpc.Empty (id: "1", state);
    Provisioning(ProvisioningStatus): Rpc.Empty (id: "2", state);
    Time(TimeSync): Rpc.Empty (id: "3", oneway);
}

/// Device telemetry, implemented by the co-processor (web dashboard).
rpc_service Telemetry (server: "coprocessor") {
    Battery(BatteryStatus): Rpc.Empty (id: "1", state);
}
