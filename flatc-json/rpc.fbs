// Framework schema: knows nothing about the application.

/// Which MCU implements a service ("s3" | "coprocessor").
attribute "server";
/// Stable method number within its service (like field `id`).
attribute "id";
/// No response is sent. Combine with `reliable` to still get an Ack.
attribute "oneway";
/// Framework retransmits until acked, receiver de-duplicates by message id.
attribute "reliable";
/// Latest-value semantics: coalesced, and re-sent automatically on link up.
attribute "state";
attribute "timeout_ms";

namespace Rpc;

enum Kind : ubyte { Request, Response, Ack }

enum Status : ubyte {
    Ok,
    UnknownMethod,
    BadRequest,
    Busy,
    Timeout,
    Internal,
}

/// First flatbuffer of every frame. The payload flatbuffer follows it.
table Header {
    kind: Kind;
    service: uint16;
    method: uint16;
    /// Unique per sender per boot (a peer reboot resets the link anyway).
    msg_id: uint32;
    /// For Response/Ack: the msg_id being answered.
    reply_to: uint32;
    status: Status;
    payload_size: uint32;
}

table Empty {}

/// Link control, service 0. A Hello after the first one means the peer rebooted.
table Hello {
    protocol_version: uint16;
    schema_hash: uint64;
}

rpc_service Link {
    Hello(Hello): Empty (id: "0", oneway);
    Ping(Empty): Empty (id: "1");
}

root_type Header;
